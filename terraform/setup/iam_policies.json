{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateBucketManagement",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:DeleteBucket",
        "s3:ListBucket", 
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::keto-granola-staging-tfstate"
    },
    {
      "Sid": "CloudflareUserManagement",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser",
        "iam:GetUser",
        "iam:DeleteUser",
        "iam:PutUserPolicy",
        "iam:GetUserPolicy",
        "iam:DeleteUserPolicy",
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:ListAccessKeys"
      ],
      "Resource": "arn:aws:iam::*:user/keto-granola-staging-cloudflare"
    }
  ]
}